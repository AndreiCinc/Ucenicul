    {
      "id": "N1",
      "name": "Delete single reminder by semantic title",
      "input": "sterge reminderul cu furnizorul",
      "llm_response": {
        "version": "brain-decision-v1",
        "intent": "cancel_reminder",
        "domain": "general",
        "response": "Am sters reminderul.",
        "debug_summary": "delete supplier reminder by title",
        "requires_confirmation": false,
        "requires_clarification": false,
        "reminder_action": { "title": "Sună furnizorul" },
        "task_action": null,
        "task_fallback_rules": [],
        "memory_action": null,
        "improvement_request": null,
        "memory_writes": []
      },
      "expected": {
        "intent": "cancel_reminder",
        "has_reminder_action": true,
        "reminder_has_title": true
      }
    },
