{
  "suite": "A",
  "name": "List Tasks",
  "phase": 1,
  "description": "Tests parser behavior for list_tasks intent with various filter scopes",
  "tests": [
    {
      "id": "A1",
      "name": "Listare simplă - toate",
      "input": "ce task-uri am?",
      "llm_response": {
        "version": "brain-decision-v1",
        "intent": "list_tasks",
        "domain": "general",
        "response": "Iată task-urile tale:",
        "debug_summary": "user asks for all tasks",
        "requires_confirmation": false,
        "requires_clarification": false,
        "task_action": null,
        "task_fallback_rules": [],
        "reminder_action": null,
        "memory_action": null,
        "improvement_request": null,
        "memory_writes": []
      },
      "expected": {
        "intent": "list_tasks",
        "filter_scope": "all",
        "has_task_action": true,
        "no_forbidden_fields": true
      }
    },
    {
      "id": "A2",
      "name": "Azi",
      "input": "ce task-uri am pe astăzi?",
      "llm_response": {
        "version": "brain-decision-v1",
