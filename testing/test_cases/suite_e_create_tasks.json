        "memory_action": null,
        "improvement_request": null,
        "memory_writes": []
      },
      "expected": {
        "intent": "create_task",
        "has_task_action": true,
        "task_due_type": "datetime"
      }
    },
    {
      "id": "E7",
      "name": "Task cu due_date dar LLM pune și due_at — mutual exclusion",
      "input": "pune task cumpărături mâine",
      "llm_response": {
        "version": "brain-decision-v1",
        "intent": "create_task",
        "domain": "general",
        "response": "OK.",
        "debug_summary": "buy tomorrow",
        "requires_confirmation": false,
        "requires_clarification": false,
        "task_action": { "title": "Cumpărături", "due_date": "2026-04-03", "due_at": "2026-04-03T09:00:00+03:00", "due_type": "date" },
        "task_fallback_rules": [],
        "reminder_action": null,
        "memory_action": null,
        "improvement_request": null,
        "memory_writes": []
      },
      "expected": {
        "intent": "create_task",
        "has_task_action": true,
        "task_due_type": "date",
        "task_due_at_null": true
      }
    }
  ]
