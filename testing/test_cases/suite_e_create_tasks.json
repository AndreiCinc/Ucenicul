        "memory_action": null,
        "improvement_request": null,
        "memory_writes": []
      },
      "expected": {
        "intent": "create_task",
        "has_task_action": true,
        "task_priority": "urgent",
        "task_due_type": "flexible"
      }
    },
    {
      "id": "E5",
      "name": "Task fără titlu — clarify",
      "input": "pune task",
      "llm_response": {
        "version": "brain-decision-v1",
        "intent": "create_task",
        "domain": "general",
        "response": "Ce task vrei?",
        "debug_summary": "no title",
        "requires_confirmation": false,
        "requires_clarification": false,
        "task_action": null,
        "task_fallback_rules": [],
        "reminder_action": null,
        "memory_action": null,
        "improvement_request": null,
        "memory_writes": []
      },
      "expected": {
        "intent": "clarify",
        "debug_contains": "missing_task_action_title"
      }
    },
    {
      "id": "E6",
      "name": "Task cu due_type lipsă — LLM dă due_at dar nu due_type",
      "input": "pune task să plătesc chiria pe 15",
      "llm_response": {
        "version": "brain-decision-v1",
        "intent": "create_task",
        "domain": "general",
