        "requires_confirmation": false,
        "requires_clarification": false,
        "task_action": { "title": "Sună chiriașul", "due_at": "2026-04-03T10:00:00+03:00", "due_type": "datetime" },
        "task_fallback_rules": [],
        "reminder_action": null,
        "memory_action": null,
        "improvement_request": null,
        "memory_writes": []
      },
      "expected": {
        "intent": "create_task",
        "has_task_action": true,
        "task_has_title": true,
        "task_due_type": "datetime"
      }
    },
    {
      "id": "E4",
      "name": "Task urgent",
      "input": "pune task urgent: scurgere la Ap 3",
      "llm_response": {
        "version": "brain-decision-v1",
        "intent": "create_task",
        "domain": "airbnb",
        "response": "Task urgent creat.",
        "debug_summary": "urgent task leak ap3",
        "requires_confirmation": false,
        "requires_clarification": false,
        "task_action": { "title": "Scurgere la Ap 3", "priority": "urgent" },
        "task_fallback_rules": [],
