{
  "suite": "E",
  "name": "Create Tasks",
  "phase": 1,
  "tests": [
    {
      "id": "E1",
      "name": "Task simplu cu titlu",
      "input": "pune-mi task să sun furnizorul",
      "llm_response": {
        "version": "brain-decision-v1",
        "intent": "create_task",
        "domain": "general",
        "response": "Am creat task-ul.",
        "debug_summary": "create task call supplier",
        "requires_confirmation": false,
        "requires_clarification": false,
        "task_action": { "title": "Sună furnizorul" },
        "task_fallback_rules": [],
        "reminder_action": null,
        "memory_action": null,
        "improvement_request": null,
        "memory_writes": []
      },
      "expected": {
        "intent": "create_task",
        "has_task_action": true,
        "task_has_title": true,
        "task_priority": "normal",
        "task_due_type": "flexible"
      }
    },
    {
      "id": "E2",
      "name": "Task cu due_date",
      "input": "pune task să cumpăr detergenți pe mâine",
      "llm_response": {
        "version": "brain-decision-v1",
        "intent": "create_task",
        "domain": "cleaning",
        "response": "Am creat task-ul pe mâine.",
        "debug_summary": "create task buy detergent tomorrow",
        "requires_confirmation": false,
        "requires_clarification": false,
        "task_action": { "title": "Cumpără detergenți", "due_date": "2026-04-03", "due_type": "date" },
        "task_fallback_rules": [],
        "reminder_action": null,
        "memory_action": null,
        "improvement_request": null,
        "memory_writes": []
      },
      "expected": {
        "intent": "create_task",
        "has_task_action": true,
        "task_has_title": true,
        "task_due_type": "date"
      }
    },
    {
      "id": "E3",
      "name": "Task cu due_at (datetime)",
      "input": "pune task să sun chiriașul mâine la 10",
      "llm_response": {
        "version": "brain-decision-v1",
        "intent": "create_task",
        "domain": "airbnb",
        "response": "Am creat task-ul.",
