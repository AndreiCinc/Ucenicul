# =============================================================================
# Ucenicul — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# =============================================================================

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ucenicul
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ucenicul
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD

# --- pgvector ---
# pgvector uses the same PostgreSQL connection. Ensure the extension is enabled:
# CREATE EXTENSION IF NOT EXISTS vector;

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com
N8N_ENCRYPTION_KEY=your-n8n-encryption-key

# --- AI Provider (OpenAI) ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/telegram

# --- Application ---
APP_TIMEZONE=Europe/Bucharest
APP_DEFAULT_CURRENCY=EUR
APP_ENV=development

# --- Encryption (for PII at rest) ---
ENCRYPTION_KEY=your-256-bit-encryption-key
