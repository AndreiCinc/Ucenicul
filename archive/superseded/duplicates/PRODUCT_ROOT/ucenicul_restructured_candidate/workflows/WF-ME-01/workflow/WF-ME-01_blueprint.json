      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json._valid }}",
              "operation": "equal",
              "value2": "true"
            }
          ]
        }
      },
      "id": "4",
      "name": "ME_Route_Valid",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM public.execution_contexts WHERE id = $1::uuid AND tenant_id = $2::uuid LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$json.execution_context_id, $json.tenant_id] }}"
        }
      },
      "id": "5",
      "name": "ME_Load_Execution_Context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "alwaysOutputData": true,
      "position": [
        1000,
        240
      ],
      "credentials": {
        "postgres": {
          "id": "CREDENTIAL_PLACEHOLDER",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM public.tasks WHERE tenant_id = $1::uuid AND (($2::uuid IS NOT NULL AND id = $2::uuid) OR ($3::text IS NOT NULL AND title ILIKE $3::text)) LIMIT 50;",
        "options": {
          "queryReplacement": "={{ [$json.tenant_id, $json.step.inputs.task_id || null, $json.step.inputs.title_match || null] }}"
        }
      },
      "id": "6",
      "name": "ME_Load_Task_Candidates",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "alwaysOutputData": true,
      "position": [
        1240,
        240
      ],
      "credentials": {
        "postgres": {
          "id": "CREDENTIAL_PLACEHOLDER",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.step.module_name }}",
              "operation": "equal",
              "value2": "task_module"
            }
          ]
        }
      },
      "id": "7",
      "name": "ME_Route_Module_Name",
