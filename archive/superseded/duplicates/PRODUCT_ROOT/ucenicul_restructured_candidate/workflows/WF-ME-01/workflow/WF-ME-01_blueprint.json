      "typeVersion": 3,
      "position": [
        1480,
        240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.step.inputs.action || 'create_task' }}",
              "operation": "equal",
              "value2": "create_task"
            },
            {
              "value1": "={{ $json.step.inputs.action }}",
              "operation": "equal",
              "value2": "list_tasks"
            },
            {
              "value1": "={{ $json.step.inputs.action }}",
              "operation": "equal",
              "value2": "update_task"
            },
            {
