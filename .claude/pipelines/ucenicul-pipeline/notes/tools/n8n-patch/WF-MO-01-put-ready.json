      }
    },
    {
      "id": "4",
      "name": "MO_Route_Valid",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        -1050,
        300
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json._valid }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        }
      }
    },
    {
      "id": "5",
      "name": "MO_Load_Execution_Context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -780,
        180
      ],
      "alwaysOutputData": true,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, tenant_id, thread_id, status, updated_at FROM public.execution_contexts WHERE id = $1::uuid AND tenant_id = $2::uuid;",
        "options": {
          "queryReplacement": "={{ [$json.execution_context_id, $json.tenant_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "qpZLzVs17Zy7HCFB",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "6",
      "name": "MO_Load_Thread_Context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -780,
        300
      ],
      "alwaysOutputData": true,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, tenant_id, status, last_activity_at FROM public.threads WHERE id = $1::uuid AND tenant_id = $2::uuid;",
        "options": {
          "queryReplacement": "={{ [$('MO_Validate_Composed_Response_Input').first().json.thread_id, $('MO_Validate_Composed_Response_Input').first().json.tenant_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "qpZLzVs17Zy7HCFB",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "7",
      "name": "MO_Load_Channel_Delivery_Context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -780,
        420
      ],
      "alwaysOutputData": true,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id AS tenant_id, 'telegram'::text AS channel, (metadata->>'telegram_chat_id')::text AS delivery_target FROM public.tenants WHERE id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ [$('MO_Validate_Composed_Response_Input').first().json.tenant_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "qpZLzVs17Zy7HCFB",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "8",
      "name": "MO_Replay_Guard_Probe",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -780,
        540
