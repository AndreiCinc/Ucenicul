      "alwaysOutputData": true,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, idempotency_key, channel, delivery_status, created_at FROM public.outbound_delivery_ledger_claude_mcp WHERE tenant_id = $1::uuid AND idempotency_key = $2 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [$('MO_Validate_Composed_Response_Input').first().json.tenant_id, $('MO_Validate_Composed_Response_Input').first().json.composed_response.response_text] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "qpZLzVs17Zy7HCFB",
          "name": "Postgres account"
        }
